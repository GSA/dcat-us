{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resources.data.gov/dcat-us/3.0.0/definitions/agent",
  "title": "Agent",
  "description": "An entity that could be involved with a resource",
  "type": "object",
  "properties": {
    "@id": {
      "type": "string",
      "format": "iri"
    },
    "@type": {
      "type": "string",
      "default": "Agent"
    },
    "category": {
      "title": "category",
      "description": "List of categories for the Agent",
      "type": ["null", "array"],
      "items": {
        "anyOf": [
          {
            "$ref": "/dcat-us/3.0.0/definitions/concept",
            "description": "inline description of Concept"
          },
          {
            "type": "string",
            "title": "Link",
            "description": "reference iri of Concept",
            "format": "iri"
          }
        ]
      }
    },
    "name": {
      "title": "name",
      "description": "The name of the agent",
      "type": "string"
    }
  },
  "required": ["name"]
}
