{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://resources.data.gov/dcat-us/3.0.0/definitions/licensedocument",
    "title": "LicenseDocument",
    "description": "Text of the license for an item",
    "type": "object",
    "properties": {
        "@id": {
            "type": "string",
            "format": "iri"
        },
        "@type": {
            "type": "string",
            "default": "LicenseDocument"
        },
        "licenseText": {
            "title": "license text",
            "description": "Full text of the license",
            "type": [
                "null",
                "string"
            ]
        }
    },
    "required": []
}