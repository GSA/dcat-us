{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resources.data.gov/dcat-us/3.0.0/definitions/attribution",
  "title": "Attribution",
  "description": "An attribution that an agent plays some role",
  "type": "object",
  "properties": {
    "@id": {
      "type": "string",
      "format": "iri"
    },
    "@type": {
      "type": "string",
      "default": "Attribution"
    },
    "hadRole": {
      "title": "role",
      "description": "The function of an entity or agent with respect to another entity or resource",
      "type": "string"
    },
    "agent": {
      "title": "agent",
      "description": "The agent that plays a role in the resource",
      "anyOf": [
        {
          "$ref": "/dcat-us/3.0.0/definitions/agent",
          "description": "inline description of Agent"
        },
        {
          "type": "string",
          "description": "reference iri of Agent",
          "format": "iri"
        }
      ]
    }
  },
  "required": ["hadRole", "agent"]
}
