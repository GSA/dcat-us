{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resources.data.gov/dcat-us/3.0.0/definitions/dataset",
  "title": "Dataset",
  "description": "Information about a set of data",
  "type": "object",
