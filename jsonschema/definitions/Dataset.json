          {
            "$ref": "/dcat-us/3.0.0/definitions/dataset",
            "description": "inline description of Dataset"
          },
          {
            "type": "string",
            "title": "Link",
            "description": "reference iri of Dataset",
            "format": "iri"
          }
        ]
      }
    },
    "inSeries": {
      "title": "in series",
