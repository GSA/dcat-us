        "title": "DatasetSeries object or link",
        "anyOf": [
          {
            "$ref": "/dcat-us/3.0.0/definitions/datasetseries",
            "description": "inline description of DatasetSeries"
          },
          {
            "type": "string",
            "title": "Link",
            "description": "reference iri of DatasetSeries",
            "format": "iri"
          }
        ]
      }
