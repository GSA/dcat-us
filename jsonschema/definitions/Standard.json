{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resources.data.gov/dcat-us/3.0.0/definitions/standard",
  "title": "Standard",
  "description": "Information about a particular standard that another item conforms to",
  "type": "object",
  "properties": {
    "@id": {
      "type": "string",
      "format": "iri"
    },
    "@type": {
      "type": "string",
      "default": "Standard"
    },
    "created": {
      "title": "creation date",
      "description": "The date on which the Standard has been first created",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "title": "Date string",
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}$",
              "description": "A year in YYYY format"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$",
              "description": "A year and month in YYYY-MM format"
            }
          ]
        }
      ]
    },
    "description": {
      "title": "description",
      "description": "A free-text account of the Standard",
      "type": ["null", "string"]
    },
    "identifier": {
      "title": "identifier",
      "description": "The unique identifier for the Standard, e.g. the URI or other unique identifier in the context of the Catalog",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "$ref": "/dcat-us/3.0.0/definitions/identifier",
          "description": "inline description of Identifier"
        }
      ]
    },
    "otherIdentifier": {
      "title": "other identifier",
      "description": "A list of identifiers for the Standard besides the main identifier, e.g. the URI or other unique identifiers in the context of the Catalog",
      "type": ["null", "array"],
      "items": {
        "$ref": "/dcat-us/3.0.0/definitions/identifier"
      }
    },
    "issued": {
      "title": "issued",
      "description": "The date of formal issuance (e.g., publication) of the Standard",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "title": "Date string",
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}$",
              "description": "A year in YYYY format"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$",
              "description": "A year and month in YYYY-MM format"
            }
          ]
        }
      ]
    },
    "modified": {
      "title": "last modified",
      "description": "The most recent date on which the Standard was changed or modified",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "title": "Date string",
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}$",
              "description": "A year in YYYY format"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$",
              "description": "A year and month in YYYY-MM format"
            }
          ]
        }
      ]
    },
    "title": {
      "title": "title",
      "description": "A name given to the Standard",
      "type": ["null", "string"]
    },
    "category": {
      "title": "category",
      "description": "List of categories for the Standard",
      "type": ["null", "array"],
      "items": {
        "$ref": "/dcat-us/3.0.0/definitions/concept"
      }
    },
    "inScheme": {
      "title": "in scheme",
      "description": "The reference register to which the Standard belongs",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "$ref": "/dcat-us/3.0.0/definitions/conceptscheme",
          "description": "inline description of ConceptScheme"
        }
      ]
    }
  },
  "required": []
}
