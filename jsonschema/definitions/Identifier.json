{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resources.data.gov/dcat-us/3.0.0/definitions/identifier",
  "title": "Identifier",
  "description": "A unique identifier and optionally it's scheme and other relevant information",
  "anyOf": [
    {
      "type": "string"
    },
    {
      "type": "object",
      "properties": {
        "@id": {
          "type": "string",
          "format": "iri"
        },
        "@type": {
          "type": "string",
          "default": "Identifier"
        },
        "schemaAgency": {
          "title": "schema agency",
          "description": "The name of the agency that issued the identifier",
          "type": ["null", "string"]
        },
        "creator": {
          "title": "creator",
          "description": "the agency that manages the identifier scheme",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "/dcat-us/3.0.0/definitions/organization",
              "description": "inline description of the creator"
            },
            {
              "type": "string",
              "description": "reference iri of the creator",
              "format": "iri"
            }
          ]
        },
        "issued": {
          "title": "issued",
          "description": "The date of formal issuance (e.g., publication) of the Identifier",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "anyOf": [
                {
                  "format": "date-time"
                },
                {
                  "format": "date"
                },
                {
                  "pattern": "^[0-9]{4}$",
                  "description": "A year in YYYY format"
                },
                {
                  "pattern": "^[0-9]{4}-[0-9]{2}$",
                  "description": "A year and month in YYYY-MM format"
                }
              ]
            }
          ]
        },
        "version": {
          "title": "version",
          "description": "version of the identifier scheme",
          "type": ["null", "string"]
        },
        "notation": {
          "title": "notation",
          "description": "abbreviation or code from code lists for an identifier",
          "type": ["null", "string"]
        }
      },
      "required": []
    }
  ]
}
