{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Document",
    "type": "object",
    "properties": {
        "@id": {
            "type": "string",
            "format": "iri"
        },
        "@type": {
            "type": "string",
            "default": "Document"
        },
        "accessURL": {
            "title": "access URL",
            "description": "A URL that gives access to the Document.",
            "type": "string",
            "format": "iri"
        },
        "title": {
            "title": "title",
            "description": "The title of the document in the indicated language",
            "type": "string"
        },
        "titleMap": {
            "description": "Language map for property title. E.g. {'es': 'spanish words', 'fr': 'french words'}",
            "type": [
                "null",
                "object"
            ]
        },
        "creator": {
            "title": "individual author",
            "description": "The individual responsible for creating the document.",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/definitions/Person",
                                "description": "inline description of Person"
                            },
                            {
                                "type": "string",
                                "description": "reference iri of Person",
                                "format": "iri"
                            }
                        ]
                    }
                }
            ]
        },
        "corporateCreator": {
            "title": "corporate author",
            "description": "The organization responsible for creating the document.",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/definitions/Organization",
                                "description": "inline description of Organization"
                            },
                            {
                                "type": "string",
                                "description": "reference iri of Organization",
                                "format": "iri"
                            }
                        ]
                    }
                }
            ]
        },
        "creators": {
            "title": "author(s) as literal",
            "description": "list of authors as a literal",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            ]
        },
        "publisher": {
            "title": "publisher",
            "description": "The organization that published the document",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "oneOf": [
                        {
                            "$ref": "#/definitions/Organization",
                            "description": "inline description of Organization"
                        },
                        {
                            "type": "string",
                            "description": "reference iri of Organization",
                            "format": "iri"
                        }
                    ]
                }
            ]
        },
        "publishers": {
            "title": "publisher(s) as literal",
            "description": "list of publishers as a literal",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            ]
        },
        "identifier": {
            "title": "identifier",
            "description": "This property contains a unique identifier for the Document (e.g. DOI, ISBN)",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            ]
        },
        "issued": {
            "title": "publication date",
            "description": "publication date of the document",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "string",
                    "oneOf": [
                        {
                            "format": "date-time"
                        },
                        {
                            "format": "date"
                        },
                        {
                            "pattern": "^[0-9]{4}$",
                            "description": "A year in YYYY format"
                        },
                        {
                            "pattern": "^[0-9]{4}-[0-9]{2}$",
                            "description": "A year and month in YYYY-MM format"
                        }
                    ]
                }
            ]
        },
        "bibliographicCitation": {
            "title": "bibliographic citation",
            "description": "Bibliographic citation as text",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "string"
                }
            ]
        },
        "type": {
            "title": "document type",
            "description": "The type, nature, or genre of the document",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "oneOf": [
                        {
                            "$ref": "#/definitions/Concept",
                            "description": "inline description of Concept"
                        },
                        {
                            "type": "string",
                            "description": "reference iri of Concept",
                            "format": "iri"
                        }
                    ]
                }
            ]
        },
        "abstract": {
            "title": "abstract",
            "description": "Text abstract of the document",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "string"
                }
            ]
        },
        "abstractMap": {
            "description": "Language map for property title. E.g. {'es': 'spanish words', 'fr': 'french words'}",
            "type": [
                "null",
                "object"
            ]
        },
        "description": {
            "title": "description",
            "description": "A free-text account of the Document",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "string"
                }
            ]
        },
        "descriptionMap": {
            "description": "Language map for property title. E.g. {'es': 'spanish words', 'fr': 'french words'}",
            "type": [
                "null",
                "object"
            ]
        },
        "conformsTo": {
            "title": "conforms to",
            "description": "This property refers to a standard which the described Document conforms to.",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/definitions/Standard",
                                "description": "inline description of Standard"
                            },
                            {
                                "type": "string",
                                "description": "reference iri of Standard",
                                "format": "iri"
                            }
                        ]
                    }
                }
            ]
        },
        "mediaType": {
            "title": "media type",
            "description": "The file format of the Document as defined in the official register of media types managed by IANA.",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "oneOf": [
                        {
                            "$ref": "#/definitions/MediaType",
                            "description": "inline description of MediaType"
                        },
                        {
                            "type": "string",
                            "description": "reference iri of MediaType",
                            "format": "iri"
                        }
                    ]
                }
            ]
        }
    },
    "required": [
        "accessURL",
        "title"
    ]
}