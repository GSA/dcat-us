{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resources.data.gov/dcat-us/3.0.0/definitions/document",
  "title": "Document",
  "description": "Information about a text document",
  "type": "object",
  "properties": {
    "@id": {
      "type": "string",
      "format": "iri"
    },
    "@type": {
      "type": "string",
      "default": "Document"
    },
    "accessURL": {
      "title": "access URL",
      "description": "A URL that gives access to the Document",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "type": "string",
          "title": "URL",
          "description": "reference iri of Document",
          "format": "iri"
        }
      ]
    },
    "downloadURL": {
      "title": "download URL",
      "description": "A URL that is a direct link to a downloadable file of the Document in a given format",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "type": "string",
          "title": "URL",
          "description": "reference iri of Document",
          "format": "iri"
        }
      ]
    },
    "creator": {
      "title": "author",
      "description": "The individual(s) responsible for creating the Document",
      "type": ["null", "array"],
      "items": {
        "title": "Kind or link",
        "anyOf": [
          {
            "$ref": "/dcat-us/3.0.0/definitions/kind",
            "description": "inline description of author"
          },
          {
            "type": "string",
            "title": "Link",
            "description": "reference iri of author",
            "format": "iri"
          }
        ]
      }
    },
    "mediaType": {
      "title": "media type",
      "description": "The file format of the Document as defined in the official register of media types managed by IANA",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "$ref": "/dcat-us/3.0.0/definitions/mediatype",
          "description": "inline description of MediaType"
        },
        {
          "type": "string",
          "title": "Link",
          "description": "reference iri of MediaType",
          "format": "iri"
        }
      ]
    },
    "abstract": {
      "title": "abstract",
      "description": "Text abstract of the Document",
      "type": ["null", "string"]
    },
    "abstractMap": {
      "description": "Language map for abstract. E.g. {'es': 'spanish words', 'fr': 'french words'}",
      "type": ["null", "object"]
    },
    "bibliographicCitation": {
      "title": "bibliographic citation",
      "description": "Bibliographic citation as text",
      "type": ["null", "string"]
    },
    "conformsTo": {
      "title": "conforms to",
      "description": "List of standards that the Document conforms to",
      "type": ["null", "array"],
      "items": {
        "title": "Standard object or link",
        "anyOf": [
          {
            "$ref": "/dcat-us/3.0.0/definitions/standard",
            "description": "inline description of Standard"
          },
          {
            "type": "string",
            "title": "Link",
            "description": "reference iri of Standard",
            "format": "iri"
          }
        ]
      }
    },
    "corporateCreator": {
      "title": "corporate author",
      "description": "The corporate organization(s) responsible for creating the Document",
      "type": ["null", "array"],
      "items": {
        "title": "Organization or link",
        "anyOf": [
          {
            "$ref": "/dcat-us/3.0.0/definitions/organization",
            "description": "inline description of corporate author"
          },
          {
            "type": "string",
            "title": "Link",
            "description": "reference iri of corporate author",
            "format": "iri"
          }
        ]
      }
    },
    "description": {
      "title": "description",
      "description": "A free-text account of the Document",
      "type": ["null", "string"]
    },
    "descriptionMap": {
      "description": "Language map for description. E.g. {'es': 'spanish words', 'fr': 'french words'}",
      "type": ["null", "object"]
    },
    "identifier": {
      "title": "identifier",
      "description": "The unique identifier for the Document (e.g. DOI, ISBN)",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "$ref": "/dcat-us/3.0.0/definitions/identifier",
          "description": "inline description of Identifier"
        },
        {
          "type": "string",
          "title": "Link",
          "description": "reference iri of Identifier",
          "format": "iri"
        }
      ]
    },
    "otherIdentifier": {
      "title": "other identifier",
      "description": "A list of identifiers for the Document besides the main identifier, e.g. the URI or other unique identifiers in the context of the Catalog",
      "type": ["null", "array"],
      "items": {
        "title": "Identifier object or link",
        "anyOf": [
          {
            "$ref": "/dcat-us/3.0.0/definitions/identifier",
            "description": "inline description of Identifier"
          },
          {
            "type": "string",
            "title": "Link",
            "description": "reference iri of Identifier",
            "format": "iri"
          }
        ]
      }
    },
    "issued": {
      "title": "publication date",
      "description": "Publication date of the Document",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}$",
              "description": "A year in YYYY format"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$",
              "description": "A year and month in YYYY-MM format"
            }
          ]
        }
      ]
    },
    "publisher": {
      "title": "publisher",
      "description": "The organization(s) that published the Document",
      "type": ["null", "array"],
      "items": {
        "title": "Organization object or link",
        "anyOf": [
          {
            "$ref": "/dcat-us/3.0.0/definitions/organization",
            "description": "inline description of publisher"
          },
          {
            "type": "string",
            "title": "Link",
            "description": "reference iri of publisher",
            "format": "iri"
          }
        ]
      }
    },
    "title": {
      "title": "title",
      "description": "The title of the Document",
      "type": "string"
    },
    "titleMap": {
      "description": "Language map for property title. E.g. {'es': 'spanish words', 'fr': 'french words'}",
      "type": ["null", "object"]
    },
    "category": {
      "title": "category",
      "description": "List of categories/genres for the Document",
      "type": ["null", "array"],
      "items": {
        "title": "Category or link",
        "anyOf": [
          {
            "$ref": "/dcat-us/3.0.0/definitions/concept",
            "description": "inline description of Concept"
          },
          {
            "type": "string",
            "title": "Link",
            "description": "reference iri of Concept",
            "format": "iri"
          }
        ]
      }
    }
  },
  "required": ["title"]
}
