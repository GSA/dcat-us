{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resources.data.gov/dcat-us/3.0.0/definitions/document",
  "title": "Document",
  "description": "Information about a text document",
  "type": "object",
  "properties": {
    "@id": {
      "type": "string",
      "format": "iri",
      "examples": ["https://example.gov/documents/climate-user-guide-001"]
    },
    "@type": {
      "type": "string",
      "default": "Document",
      "examples": ["Document"]
    },
    "accessURL": {
      "title": "access URL",
      "description": "A URL that gives access to the Document",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "type": "string",
          "title": "URL",
          "description": "reference iri of Document",
          "format": "iri"
        }
      ],
      "oldDocs": {
        "requirementLevel": "Optional"
      },
      "examples": ["https://example.gov/docs/climate-user-guide"]
    },
    "downloadURL": {
      "title": "download URL",
      "description": "A URL that is a direct link to a downloadable file of the Document in a given format",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "type": "string",
          "title": "URL",
          "description": "reference iri of Document",
          "format": "iri"
        }
      ],
      "oldDocs": {
        "requirementLevel": "Optional"
      },
      "examples": ["https://example.gov/docs/climate-user-guide.pdf"]
    },
    "creator": {
      "title": "author",
      "description": "The individual(s) responsible for creating the Document",
      "type": ["null", "array"],
      "items": {
        "$ref": "/dcat-us/3.0.0/definitions/kind"
      },
      "oldDocs": {
        "requirementLevel": "Optional",
        "cardinality": "0..n",
        "uri": "dcterms:creator",
        "range": "org:Organization"
      },
      "examples": [
        [
          {
            "@id": "https://example.gov/contacts/doc-author-001",
            "@type": "Kind",
            "fn": "Dr. Jane Smith",
            "hasEmail": "mailto:jane.smith@example.gov",
            "given-name": "Jane",
            "family-name": "Smith",
            "organization-name": "National Climate Data Center",
            "title": "Senior Climate Scientist"
          }
        ]
      ]
    },
    "mediaType": {
      "title": "media type",
      "description": "The file format of the Document as defined in the official register of media types managed by IANA: https://www.iana.org/assignments/media-types/media-types.xhtml",
      "type": ["null", "string"],
      "oldDocs": {
        "requirementLevel": "Optional",
        "cardinality": "0..n",
        "uri": "dcterms:mediaType",
        "range": "dcterms:MediaType",
        "usageNote": "An implementing rule or other specification."
      },
      "examples": ["application/pdf"]
    },
    "abstract": {
      "title": "abstract",
      "description": "Text abstract of the Document",
      "type": ["null", "string"],
      "oldDocs": {
        "requirementLevel": "Optional",
        "cardinality": "0..n",
        "uri": "dcterms:abstract",
        "range": "rdfs:Literal"
      },
      "examples": [
        "This document provides detailed instructions for using climate data products, including API access, file formats, and data interpretation guidelines."
      ]
    },
    "bibliographicCitation": {
      "title": "bibliographic citation",
      "description": "Bibliographic citation as text",
      "type": ["null", "string"],
      "oldDocs": {
        "requirementLevel": "Recommended",
        "cardinality": "0..1",
        "uri": "dcterms:bibliographicCitation",
        "range": "rdfs:Literal"
      },
      "examples": [
        "National Climate Data Center. (2024). Climate Data User Guide. Retrieved from https://example.gov/docs/climate-user-guide",
        "National Climate Data Center. (2024). Climate Data User Guide. U.S. Department of Commerce."
      ]
    },
    "conformsTo": {
      "title": "conforms to",
      "description": "List of standards that the Document conforms to",
      "type": ["null", "array"],
      "items": {
        "$ref": "/dcat-us/3.0.0/definitions/standard"
      },
      "oldDocs": {
        "requirementLevel": "Optional",
        "cardinality": "0..n",
        "uri": "dcterms:identifier",
        "range": "dcterms:Standard",
        "usageNote": "An implementing rule or other specification."
      },
      "examples": [
        [
          {
            "@id": "https://example.gov/standards/pdf-a",
            "@type": "Standard",
            "title": "PDF/A-3",
            "description": "ISO 19005-3 - Document management -- Electronic document file format for long-term preservation."
          }
        ]
      ]
    },
    "corporateCreator": {
      "title": "corporate author",
      "description": "The corporate organization(s) responsible for creating the Document",
      "type": ["null", "array"],
      "items": {
        "$ref": "/dcat-us/3.0.0/definitions/organization"
      },
      "oldDocs": {
        "requirementLevel": "Optional"
      },
      "examples": [
        [
          {
            "@id": "https://example.gov/organizations/ncdc",
            "@type": "Organization",
            "name": "National Climate Data Center"
          }
        ]
      ]
    },
    "description": {
      "title": "description",
      "description": "A free-text account of the Document",
      "type": ["null", "string"],
      "oldDocs": {
        "requirementLevel": "Recommended",
        "cardinality": "0..n",
        "uri": "dcterms:description",
        "range": "rdfs:Literal",
        "definition": "Description of the document."
      },
      "examples": [
        "A guide for accessing and using the National Climate Data Center's data products.",
        "A comprehensive guide for accessing and using the National Climate Data Center's data products and services."
      ]
    },
    "identifier": {
      "title": "identifier",
      "description": "The unique identifier for the Document (e.g. DOI, ISBN)",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "$ref": "/dcat-us/3.0.0/definitions/identifier",
          "description": "inline description of Identifier"
        }
      ],
      "oldDocs": {
        "requirementLevel": "Recommended",
        "cardinality": "0..1",
        "uri": "dcterms:identifier",
        "range": "rdfs:Literal"
      },
      "examples": [
        "NCDC-UG-2024-001",
        {
          "@type": "Identifier",
          "schemaAgency": "example.gov",
          "notation": "DOC-CLIMATE-GUIDE-001"
        }
      ]
    },
    "otherIdentifier": {
      "title": "other identifier",
      "description": "A list of identifiers for the Document besides the main identifier, e.g. the URI or other unique identifiers in the context of the Catalog",
      "type": ["null", "array"],
      "items": {
        "$ref": "/dcat-us/3.0.0/definitions/identifier"
      },
      "oldDocs": {
        "requirementLevel": "Optional"
      },
      "examples": [
        [
          {
            "@type": "Identifier",
            "schemaAgency": "DOI",
            "notation": "10.12345/climate-guide-2024"
          },
          {
            "@type": "Identifier",
            "schemaAgency": "ISBN",
            "notation": "978-0-123456-78-9"
          }
        ]
      ]
    },
    "issued": {
      "title": "publication date",
      "description": "Publication date of the Document",
      "anyOf": [
        {
          "type": "null",
          "title": "Null allowed when not required"
        },
        {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}$",
              "description": "A year in YYYY format"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$",
              "description": "A year and month in YYYY-MM format"
            }
          ]
        }
      ],
      "oldDocs": {
        "requirementLevel": "Recommended",
        "cardinality": "0..n",
        "uri": "dcterms:issued",
        "range": "rdfs:Literal"
      },
      "examples": ["2024-03-15", "2024-01-15"]
    },
    "publisher": {
      "title": "publisher",
      "description": "The organization(s) that published the Document",
      "type": ["null", "array"],
      "items": {
        "$ref": "/dcat-us/3.0.0/definitions/organization"
      },
      "oldDocs": {
        "requirementLevel": "Recommended",
        "cardinality": "0..n",
        "uri": "dc:publisher",
        "range": "rdfs:Literal",
        "usageNote": "Use this property to represent publisher as literal string and not structured data."
      },
      "examples": [
        [
          {
            "@type": "Organization",
            "name": "National Climate Data Center"
          }
        ],
        [
          {
            "@id": "https://example.gov/organizations/noaa",
            "@type": "Organization",
            "name": "National Oceanic and Atmospheric Administration"
          }
        ]
      ]
    },
    "title": {
      "title": "title",
      "description": "The title of the Document",
      "type": "string",
      "oldDocs": {
        "requirementLevel": "Mandatory",
        "cardinality": "1..n",
        "uri": "dcterms:title",
        "range": "rdfs:Literal"
      },
      "examples": ["Climate Data User Guide"]
    },
    "category": {
      "title": "category",
      "description": "List of categories/genres for the Document",
      "type": ["null", "array"],
      "items": {
        "$ref": "/dcat-us/3.0.0/definitions/concept"
      },
      "oldDocs": {
        "requirementLevel": "Optional"
      },
      "examples": [
        [
          {
            "@id": "https://example.gov/concepts/user-guide",
            "@type": "Concept",
            "prefLabel": "User Guide",
            "definition": "A document that provides instructions for using a product or service.",
            "inScheme": {
              "@id": "https://example.gov/concept-schemes/document-types",
              "@type": "ConceptScheme",
              "title": "Document Types"
            }
          },
          {
            "@id": "https://example.gov/concepts/technical-documentation",
            "@type": "Concept",
            "prefLabel": "Technical Documentation",
            "definition": "Documentation describing technical aspects of a system or service.",
            "inScheme": {
              "@id": "https://example.gov/concept-schemes/document-types",
              "@type": "ConceptScheme",
              "title": "Document Types"
            }
          }
        ]
      ]
    }
  },
  "required": ["title"],
  "oldDocs": {
    "rdfClass": "foaf:Document",
    "definition": "A publication - as a scientific paper, a techni cal report, a book, book chapter, but also a blog post.",
    "usageNote": "Depending on whether a catalog supports or not publications as first-class citizens, a publication can be fully described, or simply denoted by its URI.",
    "rationale": "The introduction of foaf:Document significantly improves the representation of documents within the DCAT-US profile. It ensures that metadata about documents, such as title, format, language, and access options, are clearly defined and standardized. This alignment with global data standards fosters interoperability and eases document integration into various data ecosystems, benefiting both publishers and consumers."
  },
  "examples": [
    {
      "@type": "Document",
      "title": "Climate Data User Guide",
      "description": "A guide for accessing and using the National Climate Data Center's data products.",
      "accessURL": "https://example.gov/docs/climate-user-guide",
      "mediaType": "application/pdf",
      "identifier": "NCDC-UG-2024-001",
      "issued": "2024-03-15",
      "publisher": [
        {
          "@type": "Organization",
          "name": "National Climate Data Center"
        }
      ],
      "bibliographicCitation": "National Climate Data Center. (2024). Climate Data User Guide. Retrieved from https://example.gov/docs/climate-user-guide"
    }
  ]
}
